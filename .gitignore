# .gitignore

# Ignore OS specific files
.DS_Store
Thumbs.db

# Ignore log files
*.log

# Ignore temporary or cached files
*.tmp
*.temp
*.swp
*.swo
*.bak
*.cache

# Ignore IDE/Editor folders
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# Ignore node modules (for Node.js projects)
node_modules/

# Ignore Python compiled files
__pycache__/
*.pyc

# Ignore application specific files
.env
.env.example
config/local_settings.py
*.pem

# Ignore build files (if you're building your application for deployment)
/dist
/build

# Ignore Helm dependency build artifacts. The upstream repo gitignores these at
# its root, but the mirror is synced per-component so that root rule never
# arrives. Both are re-creatable with `helm dep update`.
Chart.lock
**/charts/*.tgz

# Keycloak manual pg_dump output (onpremise/keycloak/docs/backup-restore.md). Same reason as above:
# the upstream root rule never arrives, and a dump holds password hashes and client secrets.
onpremise/keycloak/backup/*.sql

